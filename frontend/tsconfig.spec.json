{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "moduleResolution": "bundler",
    "types": [
      "jest", "node"
    ],
    "esModuleInterop": true,
  },
  "include": [
    "src/**/*.spec.ts",
    "src/setup-jest.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out-tsc",
    "src/test.ts" // Only exclude the old Karma test.ts file if it's still lingering
  ]
}